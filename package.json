{
  "name": "aetherium",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "api:format": "node scripts/python-task.mjs ruff format apps/api",
    "api:format:check": "node scripts/python-task.mjs ruff format --check apps/api",
    "api:lint": "node scripts/python-task.mjs ruff check apps/api",
    "api:test": "node scripts/python-task.mjs pytest apps/api/tests",
    "api:typecheck": "node scripts/python-task.mjs mypy apps/api/app",
    "build": "turbo run build",
    "ci": "pnpm independence:check && pnpm world:check && pnpm deployment:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deployment:check": "node scripts/deployment-readiness-check.mjs",
    "independence:check": "node scripts/independence-check.mjs",
    "format": "prettier --write . && pnpm api:format && pnpm worker:format",
    "format:check": "prettier --check . && pnpm api:format:check && pnpm worker:format:check",
    "js:lint": "turbo run lint",
    "js:test": "turbo run test",
    "js:typecheck": "turbo run typecheck",
    "lint": "pnpm js:lint && pnpm api:lint && pnpm worker:lint",
    "test": "pnpm js:test && pnpm api:test",
    "typecheck": "pnpm js:typecheck && pnpm api:typecheck && pnpm worker:typecheck",
    "web:dev": "pnpm --filter @aetherium/web dev",
    "world:assets:check": "node scripts/world-asset-pipeline-check.mjs",
    "world:assets:report": "node scripts/world-asset-pipeline-check.mjs --report",
    "world:assets:test": "node --test scripts/world-asset-pipeline-lib.test.mjs",
    "world:check": "node scripts/no-visual-world-check.mjs && pnpm world:assets:test && pnpm world:assets:check",
    "worker:format": "node scripts/python-task.mjs ruff format --config apps/worker/pyproject.toml apps/worker",
    "worker:format:check": "node scripts/python-task.mjs ruff format --check --config apps/worker/pyproject.toml apps/worker",
    "worker:lint": "node scripts/python-task.mjs ruff check --config apps/worker/pyproject.toml apps/worker",
    "worker:typecheck": "node scripts/python-task.mjs mypy --config-file apps/worker/pyproject.toml apps/worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.0"
  }
}
